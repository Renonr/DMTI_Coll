####### Compile

natural.o: ../logic/natural.cpp ../logic/natural.h \
		../logic/number_structures.h \
		/opt/homebrew/lib/QtCore.framework/Headers/qstring.h \
		/opt/homebrew/lib/QtCore.framework/Headers/QDebug \
		/opt/homebrew/lib/QtCore.framework/Headers/QString
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o natural.o ../logic/natural.cpp

integer.o: ../logic/integer.cpp ../logic/integer.h \
		../logic/number_structures.h \
		/opt/homebrew/lib/QtCore.framework/Headers/qstring.h \
		/opt/homebrew/lib/QtCore.framework/Headers/QDebug \
		../logic/natural.h \
		/opt/homebrew/lib/QtCore.framework/Headers/QString
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o integer.o ../logic/integer.cpp

rational.o: ../logic/rational.cpp ../logic/rational.h \
		../logic/number_structures.h \
		/opt/homebrew/lib/QtCore.framework/Headers/qstring.h \
		/opt/homebrew/lib/QtCore.framework/Headers/QDebug \
		../logic/integer.h \
		../logic/natural.h \
		/opt/homebrew/lib/QtCore.framework/Headers/QString
